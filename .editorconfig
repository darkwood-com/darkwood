; top-most EditorConfig file
root = true

; Unix-style newlines
[*]
charset = utf-8
end_of_line = LF
insert_final_newline = true
trim_trailing_whitespace = true

[*.{php,html,twig,yaml,yml}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[COMMIT_EDITMSG]
max_line_length = 0

[Makefile]
indent_style = tab

[*.json]
indent_size = 2
