{% extends "darkwood/base.html.twig" %}

{% block content %}
<h1>{{ page.title }}</h1>

<a href="{{ path('hello_home') }}" class="hello">
<ul class="itemlist">
    <li>
        <h2>{{ 'darkwood.home.hello_title'|trans }}</h2>
        <p>{{ 'darkwood.home.hello_content'|trans|raw }}</p>
    </li>
</ul>
</a>

{{ include('blog/partials/article-highlights.html.twig') }}

<h2>{{ 'darkwood.home.news'|trans }}</h2>
<ul class="itemlist">
    {% for article in news %}
        <li>{{ include('blog/partials/article-preview.html.twig', {article: article}) }}</li>
    {% endfor %}
</ul>
{% endblock %}
