{% extends "blog/base.html.twig" %}

{% block content %}

<h1>{{ app.request.attributes.get('_route') == 'blog_section' and app.request.attributes.get('section') == 'auto' ? 'blog.menu.auto'|trans : page.title }}</h1>
{# page.content|markdown_to_html #}

{{ include('blog/partials/article-highlights.html.twig') }}

<h2>{{ 'blog.home.news_heading'|trans }}</h2>
<ul class="itemlist">
    {% for article in articles %}
        <li>{{ include('blog/partials/article-preview.html.twig', {article: article}) }}</li>
    {% endfor %}
</ul>


{{ knp_pagination_render(articles, 'common/partials/sliding.html.twig') }}

{% endblock %}
