{% set fallback = asset('common/images/site/cover.png') %}
{% set cover = vich_uploader_asset(translation, 'image') %}
{% set thumbnail = thumbnail|default(false) %}
{% set source = cover ? asset(cover) : fallback %}
{% if thumbnail and cover and cover matches '{^/?media/articles/[^/]+$}' %}
    {% set source = cover|split('/')|last|imagine_filter('article_cover_square') %}
{% endif %}
<img class="article-cover img-fluid d-block mx-auto" src="{{ source }}" alt="{{ cover ? translation.title : '' }}" loading="lazy" decoding="async"
     {% if thumbnail %}width="320" height="320"{% else %}style="max-height: 22rem; object-fit: contain"{% endif %}
     data-cover-fallback="{{ fallback }}" onerror="if (this.getAttribute('src') === this.dataset.coverFallback) { this.classList.replace('d-block', 'd-none'); } else { this.src = this.dataset.coverFallback; }">
