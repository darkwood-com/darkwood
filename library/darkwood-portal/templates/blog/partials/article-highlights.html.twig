{% set highlights = [
    lastAutoArticle|default(null),
    lastWatchArticle|default(null),
    lastReleaseArticle|default(null),
    lastCreatorArticle|default(null),
]|filter(article => article is not null) %}

{% if highlights is not empty %}
    <section class="article-highlights" aria-labelledby="article-highlights-heading">
        <h2 id="article-highlights-heading">{{ 'blog.home.highlights_heading'|trans }}</h2>
        <ul class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3 list-unstyled ps-0 mb-4">
            {% for article in highlights %}
                <li class="col">
                    <article class="h-100 p-3 border rounded">
                        {{ include('blog/partials/article-preview.html.twig', {article: article}) }}
                    </article>
                </li>
            {% endfor %}
        </ul>
    </section>
{% endif %}
