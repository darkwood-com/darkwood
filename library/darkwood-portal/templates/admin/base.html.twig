{% trans_default_domain "admin" %}
{% block form_theme %}
    {% if form is defined %}{% form_theme form "admin/partials/form_div_layout.html.twig" %}{% endif %}
    {% if search_form is defined %}{% form_theme search_form "admin/partials/form_div_layout.html.twig" %}{% endif %}
    {% if edit_form is defined %}{% form_theme edit_form "admin/partials/form_div_layout.html.twig" %}{% endif %}
    {% if delete_form is defined %}{% form_theme delete_form "admin/partials/form_div_layout.html.twig" %}{% endif %}
{% endblock %}
<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
    <meta charset="UTF-8" />
    <title>Administration</title>

    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta content="" name="description" />
    <meta content="" name="author" />

    {# Third-party files are restored by npm ci and generated by Encore. #}
    <link href="{{ asset('/build/admin/vendor/jquery-ui-dist/jquery-ui.min.css') }}" rel="stylesheet" />
    <link href="{{ asset('/build/admin/vendor/bootstrap/dist/css/bootstrap.min.css') }}" rel="stylesheet" />
    <link href="{{ asset('/build/admin/vendor/font-awesome/css/font-awesome.min.css') }}" rel="stylesheet" />
    <link href="{{ asset('/build/admin/vendor/animate.css/animate.min.css') }}" rel="stylesheet" />
    <link href="{{ asset('/build/admin/vendor/bootstrap-datepicker/dist/css/bootstrap-datepicker3.min.css') }}" rel="stylesheet" />
    <link href="{{ asset('/build/admin/vendor/gritter/css/jquery.gritter.css') }}" rel="stylesheet" />
    <link href="{{ asset('/build/admin/vendor/bootstrap-select/dist/css/bootstrap-select.min.css') }}" rel="stylesheet" />
    <link href="{{ asset('/build/admin/vendor/tag-it/css/jquery.tagit.css') }}" rel="stylesheet" />
    <link href="{{ asset('/build/admin/vendor/bootstrap-multiselect/dist/css/bootstrap-multiselect.css') }}" rel="stylesheet" />
    <link href="{{ asset('/build/admin/vendor/bootstrap-switch/dist/css/bootstrap3/bootstrap-switch.min.css') }}" rel="stylesheet" />
    <link href="{{ asset('/build/admin/vendor/bootstrap-social/bootstrap-social.css') }}" rel="stylesheet" />
    <link href="{{ asset('/build/admin/vendor/trumbowyg/dist/ui/trumbowyg.min.css') }}" rel="stylesheet" />
    <link href="{{ asset('/admin/css/style.css') }}" rel="stylesheet" />
    <link href="{{ asset('/admin/css/style-responsive.css') }}" rel="stylesheet" />
    <link href="{{ asset('/admin/css/main.css') }}" rel="stylesheet" />
    <link href="{{ asset('/admin/css/draw.css') }}" rel="stylesheet" />
    <script src="{{ asset('/build/admin/vendor/jquery/dist/jquery.min.js') }}"></script>
    <script src="{{ asset('/build/admin/vendor/jquery-ui-dist/jquery-ui.min.js') }}"></script>
    <script src="{{ asset('/build/admin/vendor/bootstrap/dist/js/bootstrap.min.js') }}"></script>
    <script src="{{ asset('/build/admin/vendor/jquery-slimscroll/jquery.slimscroll.min.js') }}"></script>
    <script src="{{ asset('/build/admin/vendor/gritter/js/jquery.gritter.min.js') }}"></script>
    <script src="{{ asset('/build/admin/vendor/bootstrap-datepicker/dist/js/bootstrap-datepicker.min.js') }}"></script>
    <script src="{{ asset('/build/admin/vendor/bootstrap-datepicker/dist/locales/bootstrap-datepicker.fr.min.js') }}"></script>
    <script src="{{ asset('/build/admin/vendor/bootstrap-select/dist/js/bootstrap-select.min.js') }}"></script>
    <script src="{{ asset('/build/admin/vendor/tag-it/js/tag-it.min.js') }}"></script>
    <script src="{{ asset('/build/admin/vendor/bootstrap-multiselect/dist/js/bootstrap-multiselect.js') }}"></script>
    <script src="{{ asset('/build/admin/vendor/bootstrap-switch/dist/js/bootstrap-switch.min.js') }}"></script>
    <script src="{{ asset('/build/admin/vendor/konami/konami.js') }}"></script>
    <script src="{{ asset('/build/admin/vendor/trumbowyg/dist/trumbowyg.min.js') }}"></script>
    <script src="{{ asset('/build/admin/vendor/trumbowyg/dist/langs/fr.min.js') }}"></script>
    <script src="{{ asset('/admin/js/apps.js') }}"></script>
    <script src="{{ asset('/admin/js/main.js') }}"></script>
<link href="{{ asset('/admin/css/design.css') }}" rel="stylesheet" />
    <script type="module" src="{{ asset('/admin/js/theme.js') }}"></script>
</head>
<body>

{% if navbarActive is not defined %}{% set navbarActive = '' %}{% endif %}

{% include "admin/partials/header.html.twig" %}

<div id="page-container">
    {% if navbarActive is not defined %}
        {% set navbarActive = '' %}
    {% endif %}

    {% include "admin/partials/navbar.html.twig" %}

    <div id="content" class="content">
        <h1 class="page-header">
            {% block mainTitle %}{% endblock mainTitle %}
            <small>{% block subTitle %}{% endblock subTitle %} </small>
        </h1>

        {% for flashMessage in app.session.flashbag.get('notice') %}<div class="alert alert-success" style="margin-top: 40px;margin-right: 8px;"><i class="fa fa-check"></i> {{ flashMessage }}</div>{% endfor %}
        {% for flashMessage in app.session.flashbag.get('error') %}<div class="alert alert-danger" style="margin-top: 40px;margin-right: 8px;"><i class="fa fa-bomb"></i> {{ flashMessage }}</div>{% endfor %}


        {% block content %}
        {% endblock content %}
    </div>
</div>
<script>
    $(document).ready(function() {
        App.init();
        // Dashboard.init();
    });
</script>
</body>
</html>
