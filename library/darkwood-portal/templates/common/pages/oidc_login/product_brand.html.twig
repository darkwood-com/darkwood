<div class="login-brand">
    <img src="{{ asset('darkwood/images/products/' ~ product.icon) }}" width="56" height="56" alt="{{ product.name }}">
    <h1>Sign in to {{ product.name }}</h1>
    <p class="login-subcopy">{{ two_factor ? 'Enter the 6-digit code from your authenticator app.' : 'Use your Darkwood account to continue.' }}</p>
</div>
