{% extends "" ~ site_ref ~ "/base.html.twig" %}

{% set login_theme = login_theme|default('default') %}
{% set login_brand = login_theme == 'default' ? 'darkwood' : login_theme %}

{% block content %}
<div class="login-shell login-theme-oidc login-theme-{{ login_brand }}">
    {% if login_brand in ['djmatyo91', 'geo'] %}
        {% include 'common/pages/oidc_login/product_brand.html.twig' with {product: darkwood_identity.products[login_brand], two_factor: false} only %}
    {% else %}
        {% include 'common/pages/oidc_login/' ~ login_brand ~ '_brand.html.twig' with {two_factor: false} only %}
    {% endif %}

    <form id="login_form" method="post" action="{{ path('security_login') }}" novalidate="novalidate">
        {% if error %}
            <div class="alert_error" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        {% if app.user %}
            <div class="alert_success">
                You are logged in as {{ app.user.username }}, <a href="{{ path('security_logout') }}">Logout</a>
            </div>
        {% endif %}

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <label for="inputUsername">{{ 'common.menu.login_username'|trans }}</label>
        <input type="text" value="{{ last_username }}" name="username" autocomplete="username" id="inputUsername" required autofocus>

        <label for="inputPassword">{{ 'common.menu.login_password'|trans }}</label>
        <input type="password" name="password" autocomplete="current-password" id="inputPassword" required>

        <input type="submit" id="login_login" name="login_login" value="{{ 'common.menu.login_btn'|trans }}">
    </form>

    <div class="login-links">
        <p>{{ 'common.login.no_account_intro'|trans }} <a href="{{ path('common_register') }}">{{ 'common.action.register'|trans|lower }}</a>{{ 'common.login.no_account_end'|trans }}</p>
        <p>{{ 'common.login.forgot_password_intro'|trans }} <a href="{{ path('common_resetting_request') }}">{{ 'common.login.forgot_password_link'|trans }}</a>{{ 'common.login.forgot_password_end'|trans }}</p>
    </div>

    <p class="login-footer">Authentication secured by Darkwood Identity.</p>
</div>
{% endblock %}
