<div class="row g-0 align-items-center">
    <div class="col-md">
        <div class="row g-0 align-items-center">
            <section class="col-md-auto d-flex flex-nowrap align-items-center">
                <h4 class="footer__title">Site</h4>
                <ul class="footer__links">
                    <li><a href="{{ path(sitemap_route) }}">{{ 'common.footer.sitemap'|trans }}</a></li>
                </ul>
            </section>

            <section class="col-md-auto d-flex flex-nowrap align-items-center">
                <h4 class="footer__title">Network</h4>
                <ul class="footer__links">
                    <li><a href="{{ path('hello_home') }}">{{ 'common.footer.hello'|trans }}</a></li>
                    <li><a href="{{ path('blog_home') }}">{{ 'common.footer.blog'|trans }}</a></li>
                    <li><a href="{{ path('apps_home') }}">{{ 'common.footer.apps'|trans }}</a></li>
                    <li><a href="{{ path('photos_home') }}">{{ 'common.footer.photos'|trans }}</a></li>
                </ul>
            </section>

            <section class="col-md-auto d-flex flex-nowrap align-items-center">
                <h4 class="footer__title">Social</h4>
                <div class="footer__socials">
                    <a class="footer__social btn btn-social-icon btn-github" aria-label="Visit our GitHub" href="https://github.com/darkwood-com" target="_blank" rel="noreferrer"><span class="fab fa-github"></span></a>
                    <a class="footer__social btn btn-social-icon btn-github" aria-label="Follow us on Twitter" href="https://twitter.com/darkwood_com" target="_blank" rel="noreferrer"><span class="fab fa-twitter"></span></a>
                    <a class="footer__social btn btn-social-icon btn-linkedin" aria-label="Connect with us on LinkedIn" href="https://www.linkedin.com/company/darkwood-com" target="_blank" rel="noreferrer"><span class="fab fa-linkedin"></span></a>
                    <a class="footer__social btn btn-social-icon btn-discord" aria-label="Join our Discord" href="https://discord.gg/TDkvp3nn3j" target="_blank" rel="noreferrer"><span class="fab fa-discord"></span></a>
                </div>
            </section>
        </div>
    </div>

    <div class="col-12 col-md-auto ms-md-auto">
        {% include '@Darkwood/components/footer.html.twig' with {
            active_product: 'darkwood',
        } only %}
    </div>
    <p class="col-12 col-md-auto ps-md-2">{{ 'common.footer.copyright'|trans({'%year%': 'now'|date('Y')}) }}</p>
</div>
