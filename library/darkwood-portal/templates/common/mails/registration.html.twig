{% extends 'common/mails/base.html.twig' %}

{% block content %}
    <p style="color:#eeeeee;font-size:20px;line-height:1.4">{{ 'email_verification.mail_welcome'|trans }}</p>
    <p style="line-height:1.5">{{ 'email_verification.mail_body'|trans }}</p>
    <p style="margin:24px 0"><a href="{{ verificationUrl }}" style="display:inline-block;padding:10px 16px;background:#eeeeee;color:#202020;border-radius:4px">{{ 'email_verification.confirm_button'|trans }}</a></p>
    <p style="line-height:1.5">{{ 'email_verification.mail_expiry'|trans({'%expires%': expiresAt|date('Y-m-d H:i', 'UTC')}) }}</p>
    <p style="line-height:1.5">{{ 'email_verification.mail_ignore'|trans }}</p>
{% endblock %}
