{% set locale = app.request.locale|default('en')|slice(0, 2) %}
<div class="dw-identity d-flex flex-wrap align-items-center justify-content-end">
    <a class="dw-identity__link" href="{{ contact_url|default(darkwood_identity.contact[locale]|default(darkwood_identity.contact.en)) }}">
        {{ 'contact'|trans({}, 'darkwood_identity') }}
    </a>
    <a class="dw-identity__link" href="{{ darkwood_identity.legal_mentions[locale]|default(darkwood_identity.legal_mentions.en) }}">
        {{ 'legal_mentions'|trans({}, 'darkwood_identity') }}
    </a>
    <nav aria-label="Darkwood Identity" class="dw-identity__navigation">
        <ul class="dw-identity__products">
            {% for key in product_keys|default(darkwood_identity.default_keys) %}
                {% if darkwood_identity.products[key] is defined %}
                    {% set product = darkwood_identity.products[key] %}
                    <li>
                        <a class="dw-identity__link" href="{{ key == 'darkwood' ? portal_url|default(product.url) : product.url }}">
                            {% if product.icon is defined %}
                                <img src="{{ asset_base_path|default('') ~ asset('darkwood/images/products/' ~ product.icon) }}" width="24" height="24" alt="{{ product.name }}">
                            {% else %}
                                {{ product.name }}
                            {% endif %}
                        </a>
                    </li>
                {% endif %}
            {% endfor %}
        </ul>
    </nav>
</div>
