{% set locale = app.request.locale|default('en')|slice(0, 2) %}
{% set contact_urls = {
    en: 'https://darkwood.com/contact',
    fr: 'https://darkwood.com/fr/contact',
    de: 'https://darkwood.com/de/kontakt',
} %}
{% set legal_mentions_urls = {
    en: 'https://darkwood.com/legal-mentions',
    fr: 'https://darkwood.com/fr/mentions-legales',
    de: 'https://darkwood.com/de/impressum',
} %}
{% set products = {
    darkwaar: {name: 'Darkwaar', url: 'https://darkwaar.com', icon: 'darkwaar.svg'},
    heroclip: {name: 'HeroClip', url: 'https://heroclip.darkwood.com', icon: 'heroclip.svg'},
    djmatyo91: {name: 'DJ Matyo', url: 'https://djmatyo91.darkwood.com', icon: 'djmatyo.svg'},
    geo: {name: 'Geo', url: 'https://geo.darkwood.com', icon: 'geo.svg'},
    uniflow: {name: 'Uniflow', url: 'https://uniflow.io'},
    slides: {name: 'Slides', url: 'https://slides.darkwood.com'},
    darkwood: {name: 'Darkwood', url: portal_url|default('https://darkwood.com'), icon: 'darkwood.svg'},
} %}
<div class="dw-identity d-flex flex-wrap align-items-center justify-content-end">
    <a class="dw-identity__link" href="{{ contact_url|default(contact_urls[locale]|default(contact_urls.en)) }}">
        {{ 'contact'|trans({}, 'darkwood_identity') }}
    </a>
    <a class="dw-identity__link" href="{{ legal_mentions_urls[locale]|default(legal_mentions_urls.en) }}">
        {{ 'legal_mentions'|trans({}, 'darkwood_identity') }}
    </a>
    <nav aria-label="Darkwood Identity" class="dw-identity__navigation">
        <ul class="dw-identity__products">
            {% for key in product_keys|default(['darkwood', 'darkwaar', 'heroclip', 'djmatyo91', 'geo']) %}
                {% if products[key] is defined %}
                    {% set product = products[key] %}
                    <li>
                        <a class="dw-identity__link" href="{{ product.url }}"{% if key == active_product|default(null) %} aria-current="true"{% endif %}>
                            {% if product.icon is defined %}
                                <img src="{{ asset_base_path|default('') ~ asset('darkwood/images/products/' ~ product.icon) }}" width="24" height="24" alt="{{ product.name }}">
                            {% else %}
                                {{ product.name }}
                            {% endif %}
                        </a>
                    </li>
                {% endif %}
            {% endfor %}
        </ul>
    </nav>
</div>
