{
    "name": "darkwood/darkwood",
    "type": "library",
    "description": "The Darkwood PHP framework",
    "keywords": ["framework", "dev"],
    "homepage": "https://darkwood.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Mathieu Ledru",
            "email": "mathieu@darkwood.fr"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5"
    },
    "replace": {
        "darkwood/navi": "self.version",
        "darkwood/flow": "self.version",
        "darkwood/media-bundle": "self.version",
        "darkwood/ia-exception-bundle": "self.version"
    },
    "conflict": {
        "symfony/symfony": "*"
    }
}
