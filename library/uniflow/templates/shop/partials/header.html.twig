{% set docsPath = path('app_shop_doc') %}
{% set docsActive = app.current_route == 'app_shop_doc' or app.request.pathInfo == docsPath or app.request.pathInfo starts with docsPath ~ '/' %}
{% set moreActive = docsActive or app.current_route in ['app_shop_settings', 'app_shop_admin'] or app.current_route starts with 'app_shop_blog' %}
<header class="dw-navbar dw-navbar--fixed dw-navbar--tabs navbar navbar-top navbar-expand flex-row">
    <!-- Logo/Brand -->
    <a class="navbar-brand dw-product-brand me-2" href="{{ path('app_shop_home') }}" aria-label="Uniflow">
        <img src="{{ asset('darkwood/images/products/uniflow.svg') }}" width="36" height="36" class="d-block" alt="Uniflow" />
    </a>

    <!-- Desktop Navigation -->
    <div class="navbar-nav-scroll d-none d-md-flex">
        <ul class="navbar-nav bd-navbar-nav flex-row">
            <li class="nav-item">
                <a class="nav-link{{ app.current_route == 'app_shop_flows' ? ' active' : '' }}" href="{{ path('app_shop_flows') }}">
                    Flows
                </a>
            </li>
            {% if app.user and is_granted('ROLE_USER') %}
            <li class="nav-item">
                <a class="nav-link{{ app.current_route == 'app_shop_feed' ? ' active' : '' }}" href="{{ path('app_shop_feed') }}">
                    Dashboard
                </a>
            </li>
            {% endif %}
            <li class="nav-item">
                <a class="nav-link{{ app.current_route == 'app_shop_library' ? ' active' : '' }}" href="{{ path('app_shop_library') }}">
                    Library
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link{{ docsActive ? ' active' : '' }}" href="{{ path('app_shop_doc') }}">
                    Docs
                </a>
            </li>
            {% if app.user and is_granted('ROLE_USER') %}
            <li class="nav-item">
                <a class="nav-link{{ app.current_route == 'app_shop_settings' ? ' active' : '' }}" href="{{ path('app_shop_settings') }}">
                    Settings
                </a>
            </li>
            {% endif %}
            {% if app.user and is_granted('ROLE_SUPER_ADMIN') %}
            <li class="nav-item">
                <a class="nav-link{{ app.current_route == 'app_shop_admin' ? ' active' : '' }}" href="{{ path('app_shop_admin') }}">
                    Admin
                </a>
            </li>
            {% endif %}
            <li class="nav-item">
                <a class="nav-link{{ app.current_route starts with 'app_shop_blog' ? ' active' : '' }}" href="{{ path('app_shop_blog') }}">
                    Blog
                </a>
            </li>
        </ul>
    </div>

    <!-- Right Side Navigation -->
    <ul class="navbar-nav flex-row ms-auto">
        <li class="nav-item">
            <a class="nav-item nav-link{{ app.current_route == 'app_shop_changelog' ? ' active' : '' }}" href="{{ path('app_shop_changelog') }}">
                {{ display_version() }}
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="https://github.com/uniflow-io/uniflow" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
                <twig:ux:icon name="bi:github" class="svg-inline--fa" />
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="https://x.com/uniflow_io" target="_blank" rel="noopener noreferrer" aria-label="Uniflow · X">
                {{ include('@Darkwood/components/x-icon.html.twig') }}
            </a>
        </li>
        <li class="nav-item">
            <button type="button" class="nav-link border-0 bg-transparent dw-theme-toggle" aria-label="Theme" id="theme-switcher"
                data-light="{{ asset('darkwood/images/themes/light.svg') }}"
                data-dark="{{ asset('darkwood/images/themes/dark.svg') }}"
                data-sepia="{{ asset('darkwood/images/themes/sepia.svg') }}">
                <img src="{{ asset('darkwood/images/themes/light.svg') }}" width="20" height="20" alt="">
            </button>
        </li>
        {% if not app.user %}
        <li class="nav-item">
            <a class="nav-link{{ app.current_route == 'app_shop_login' ? ' active' : '' }}" href="{{ path('app_shop_login') }}">
                Login
            </a>
        </li>
        {% endif %}
        {% if app.user and is_granted('ROLE_USER') %}
        <li class="nav-item">
            <a class="nav-link" href="{{ path('sylius_shop_logout') }}">
                <twig:ux:icon name="hugeicons:logout-04" class="svg-inline--fa" />
            </a>
        </li>
        {% endif %}
    </ul>
</header>

<!-- Mobile Bottom Navigation -->
<nav class="d-md-none" aria-label="Mobile navigation">
<ul class="nav nav-bar-bottom fixed-bottom d-flex">
    <li class="nav-item">
        <a class="nav-link{{ app.current_route == 'app_shop_flows' ? ' active' : '' }}" href="{{ path('app_shop_flows') }}"{% if app.current_route == 'app_shop_flows' %} aria-current="page"{% endif %}>
            <span aria-hidden="true">↝</span>Flows
        </a>
    </li>
    {% if app.user and is_granted('ROLE_USER') %}
    <li class="nav-item">
        <a class="nav-link{{ app.current_route == 'app_shop_feed' ? ' active' : '' }}" href="{{ path('app_shop_feed') }}"{% if app.current_route == 'app_shop_feed' %} aria-current="page"{% endif %}>
            <span aria-hidden="true">▥</span>Dashboard
        </a>
    </li>
    {% endif %}
    <li class="nav-item">
        <a class="nav-link{{ app.current_route == 'app_shop_library' ? ' active' : '' }}" href="{{ path('app_shop_library') }}"{% if app.current_route == 'app_shop_library' %} aria-current="page"{% endif %}>
            <span aria-hidden="true">▦</span>Library
        </a>
    </li>
    <li class="nav-item">
        <details class="mobile-more">
            <summary class="nav-link{{ moreActive ? ' active' : '' }}"><span aria-hidden="true">…</span>More</summary>
            <ul class="mobile-more__links">
            <li class="nav-item">
                <a class="nav-link{{ docsActive ? ' active' : '' }}" href="{{ path('app_shop_doc') }}"{% if docsActive %} aria-current="page"{% endif %}>
                    <span aria-hidden="true">≡</span>Docs
                </a>
            </li>
            {% if app.user and is_granted('ROLE_USER') %}
            <li class="nav-item">
                <a class="nav-link{{ app.current_route == 'app_shop_settings' ? ' active' : '' }}" href="{{ path('app_shop_settings') }}"{% if app.current_route == 'app_shop_settings' %} aria-current="page"{% endif %}>
                    <span aria-hidden="true">⚙</span>Settings
                </a>
            </li>
            {% endif %}
            {% if app.user and is_granted('ROLE_SUPER_ADMIN') %}
            <li class="nav-item">
                <a class="nav-link{{ app.current_route == 'app_shop_admin' ? ' active' : '' }}" href="{{ path('app_shop_admin') }}"{% if app.current_route == 'app_shop_admin' %} aria-current="page"{% endif %}>
                    <span aria-hidden="true">⚙</span>Admin
                </a>
            </li>
            {% endif %}
            <li class="nav-item">
                <a class="nav-link{{ app.current_route starts with 'app_shop_blog' ? ' active' : '' }}" href="{{ path('app_shop_blog') }}"{% if app.current_route starts with 'app_shop_blog' %} aria-current="page"{% endif %}>
                    <span aria-hidden="true">≡</span>Blog
                </a>
            </li>
            </ul>
        </details>
    </li>
</ul>
</nav>
