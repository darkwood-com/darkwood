{% extends 'shop/base.html.twig' %}

{% block body %}
<section class="section container py-4">
    <div class="row justify-content-center">
        <div class="col-sm-10 col-lg-6">
            <div class="card dw-product-card">
                <div class="card-body">
                    <h1 class="h3">Sign in to Uniflow</h1>
                    {% for message in app.flashes('darkwood_login_error') %}
                        <p class="alert alert-warning" role="alert">{{ message }}</p>
                    {% endfor %}
                    {% if darkwood_issuer %}
                        <p><a class="btn btn-primary dw-product-action" href="{{ path('app_shop_darkwood_login') }}">Sign in with Darkwood Identity</a></p>
                        <p class="mb-2">Already have a Uniflow account? Use the same email address to activate your Darkwood account.</p>
                        <p class="mb-2"><a href="{{ darkwood_issuer }}/resetting/request">Activate your account or reset your Darkwood password</a></p>
                        <p class="mb-0"><a href="{{ darkwood_issuer }}/register">Create a Darkwood account</a></p>
                    {% else %}
                        <p class="alert alert-warning mb-0" role="alert">Darkwood Identity is temporarily unavailable.</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
