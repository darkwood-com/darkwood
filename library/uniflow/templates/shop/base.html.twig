<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <link rel="icon" type="image/svg+xml" href="{{ asset('darkwood/images/products/uniflow.svg') }}">
        <title>{{ page.title }}</title>
        <meta name="description" content="{{ page.description }}" />

        <meta property="og:title" content="{{ page.title }}" />
        <meta property="og:description" content="{{ page.description }}" />
        {% set editorialRoutes = ['app_shop_home', 'app_shop_blog', 'app_shop_tags', 'app_shop_tag', 'app_shop_article', 'app_shop_doc', 'app_shop_library', 'app_shop_changelog'] %}
        {% set canonical = app.request.attributes.get('_route') in editorialRoutes ? 'https://uniflow.io' ~ app.request.pathInfo : null %}
        {% if canonical %}
            <link rel="canonical" href="{{ canonical }}">
        {% endif %}
        <meta property="og:url" content="{{ canonical ?? app.request.uri }}" />
        <meta property="og:type" content="website" />
        <meta property="og:locale" content="en" />
        <meta property="og:site_name" content="Uniflow" />
        <meta property="og:image" content="{{ absolute_url(asset('images/logo.png')) }}" />
        <meta property="og:image:width" content="512" />
        <meta property="og:image:height" content="512" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="uniflow_io" />
        <meta name="twitter:title" content="{{ page.title }}" />
        <meta name="twitter:description" content="{{ page.description }}" />
        <meta name="twitter:image" content="{{ absolute_url(asset('darkwood/images/products/uniflow.svg')) }}" />

        <link rel="stylesheet" href="{{ asset('darkwood/styles/darkwood-shared.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/app.scss') }}">
        {# <link rel="manifest" href="/site.webmanifest"> #}
        {# encore_entry_link_tags('app') #}
    </head>
    <body id="{{ page.page }}" class="theme-light dw-product">
        {% include 'shop/partials/header.html.twig' %}
        {% include 'shop/partials/alerts.html.twig' %}
        <main>{% block body %}{% endblock %}</main>
        {% include 'shop/partials/footer.html.twig' %}
    </body>
    {{ encore_entry_script_tags('app-shop-entry', null, 'app.shop') }}
</html>
