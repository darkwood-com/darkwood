{% extends 'base.html.twig' %}

{% block body %}
    <section class="panel">
        <div class="row">
            <h2>AI connections</h2>
            <a class="button" href="{{ path('connection_new') }}">Add connection</a>
        </div>

        {% if connections is empty %}
            <p class="muted">No connections yet. Add a provider and API key — the plaintext key is never stored.</p>
        {% else %}
            <table>
                <thead>
                    <tr>
                        <th>Label</th>
                        <th>Provider</th>
                        <th>Model</th>
                        <th>Credential</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for connection in connections %}
                        <tr>
                            <td>{{ connection.label }}</td>
                            <td>{{ connection.provider }}</td>
                            <td><code>{{ connection.model }}</code></td>
                            <td>
                                <span class="chip">encrypted</span>
                                <span class="muted">{{ connection.kmsKeyId }}</span>
                            </td>
                            <td class="actions">
                                <a href="{{ path('connection_edit', {id: connection.id}) }}">Edit</a>
                                <form method="post" action="{{ path('connection_test', {id: connection.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('test_connection') }}">
                                    <button type="submit">Test connection</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </section>
{% endblock %}
