# Copy to .env.local and replace placeholders. Never commit real credentials.

APP_ENV=dev
APP_SECRET=change-me

# SQLite is enough for this experiment.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"

# Development: Sodium. Generate a key with:
#   php -r 'require "vendor/autoload.php"; echo Symfony\Component\KeyManagement\Base64UrlSafe::encode(sodium_crypto_aead_xchacha20poly1305_ietf_keygen()), PHP_EOL;'
DEV_KMS_KEY=CHANGE_ME_BASE64URL_SODIUM_KEY
KMS_KEY_ID=app-key
KMS_BACKEND=Sodium

# Production/reference (APP_ENV=prod). Requires an AWS account. Do not commit credentials.
# AWS_KMS_REGION=eu-west-1
# KMS_KEY_ID=alias/app-key
# KMS_BACKEND=AWS KMS
