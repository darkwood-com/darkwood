{% extends 'base.html.twig' %}

{% block title %}Run Stream{% endblock %}

{% block body %}
    <main
        class="run-stream"
        data-controller="run-stream"
        data-run-stream-default-run-value="{{ runs[0] ?? '' }}"
    >
        <h1>Run Stream</h1>
        <p>Choisis un run NDJSON puis lis le flux SSE en direct.</p>

        <div class="run-stream__controls">
            <label for="run-id">Run ID</label>
            <input
                id="run-id"
                type="text"
                list="run-options"
                placeholder="ex: unsupervised"
                data-run-stream-target="runId"
            >
            <datalist id="run-options">
                {% for run in runs %}
                    <option value="{{ run }}"></option>
                {% endfor %}
            </datalist>

            <button type="button" data-action="run-stream#start">Start</button>
            <button type="button" data-action="run-stream#stop">Stop</button>
            <button type="button" data-action="run-stream#togglePlayback" data-run-stream-target="playback">Pause</button>
            <button type="button" data-action="run-stream#reset">Reset</button>
        </div>

        <div class="run-stream__controls run-stream__controls--secondary">
            <label>
                Speed
                <input
                    type="range"
                    min="50"
                    max="1000"
                    step="50"
                    value="250"
                    data-run-stream-target="speed"
                    data-action="input->run-stream#updateSpeed"
                >
            </label>
            <span><strong data-run-stream-target="speedLabel">250</strong> ms/frame</span>
            <label>
                <input
                    type="checkbox"
                    checked
                    data-run-stream-target="grid"
                    data-action="change->run-stream#redrawCurrentFrame"
                >
                Grid
            </label>
        </div>

        <div class="run-stream__meta">
            <span>Generation: <strong data-run-stream-target="generation">-</strong></span>
            <span>Frame: <strong data-run-stream-target="frameIndex">-</strong></span>
            <span>Fitness: <strong data-run-stream-target="fitness">-</strong></span>
            <span>Avg fitness: <strong data-run-stream-target="averageFitness">-</strong></span>
            <span>Seed: <strong data-run-stream-target="seed">-</strong></span>
            <span>Mode: <strong data-run-stream-target="mode">-</strong></span>
            <span>Dataset: <strong data-run-stream-target="dataset">-</strong></span>
        </div>

        <section class="run-stream__viewer">
            <canvas
                width="320"
                height="320"
                class="run-stream__canvas"
                data-run-stream-target="canvas"
            ></canvas>

            <details class="run-stream__program">
                <summary>Winning lambda program</summary>
                <pre data-run-stream-target="program">-</pre>
            </details>
        </section>

        <pre class="run-stream__status" data-run-stream-target="status">Idle</pre>
    </main>
{% endblock %}
