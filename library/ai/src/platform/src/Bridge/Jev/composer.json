{
    "name": "darkwood/ai-jev-platform",
    "description": "TypeSafe Jev platform bridge for Symfony AI",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "ai",
        "bridge",
        "jev",
        "platform",
        "typesafe",
        "symfony"
    ],
    "authors": [
        {
            "name": "Mathieu Ledru",
            "email": "matyo91@gmail.com"
        },
        {
            "name": "Symfony Community",
            "homepage": "https://symfony.com/contributors"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/ai-platform": "^0.13",
        "symfony/http-client": "^7.3|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5.53"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Darkwood\\AI\\Platform\\Bridge\\Jev\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Darkwood\\AI\\Platform\\Bridge\\Jev\\Tests\\": "Tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "thanks": {
            "name": "darkwood/ai",
            "url": "https://github.com/darkwood-com/ai"
        }
    }
}
