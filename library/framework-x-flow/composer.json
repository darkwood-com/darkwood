{
    "name": "darkwood/framework-x-flow",
    "description": "Experimental demo: Framework X HTTP runtime + Darkwood Flow orchestration",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "clue/framework-x": "^0.17",
        "darkwood/flow": "^8.1",
        "react/async": "^4.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "start": "php public/index.php",
        "experiment": "php bin/experiment"
    }
}
