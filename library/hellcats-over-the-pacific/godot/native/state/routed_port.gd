# pacific_conflict.gd:6140 animate_landing_gear
func animate_landing_gear(ctl: int) -> int:
	assert(memory != null, "animate_landing_gear requires original global memory")
	assert(a7 != 0, "animate_landing_gear needs a7 (its frame holds the gear matrices)")
	var entry_a7: int = a7
	var a6: int = entry_a7 - 4
	var matrix_pos: int = a6 - 0x1e
	var matrix_neg: int = a6 - 0x30
	var obj: int = _routed.read_u32(ctl)
	var pos: int = _routed.read_s8(ctl + 0x679)
	if (_routed.read_u8(ctl + 0x67a) & 2) != 0 or (pos != 0x2d and abs_int(pos) > 0):
		var up: bool = pos == 0
		if up or pos == 0x2d:
			_routed.write_u8(ctl + 0x67a, _routed.read_u8(ctl + 0x67a) & 0xfd)
		else:
			_routed.write_u8(ctl + 0x67a, _routed.read_u8(ctl + 0x67a) | 2)
		var face: int = _routed.read_u32(obj + 0x48)
		if up:
			_routed.write_u8(ctl + 0x67a, _routed.read_u8(ctl + 0x67a) | 1)
			var left: int = _routed.read_u16(obj + 0x3a)
			while true:
				left = C68kScript.u16(left - 1)
				if left == 0xffff:
					break
				if _routed.read_u8(face + 0x17) == 1:
					_routed.write_u8(face + 0x13, _routed.read_u8(face + 0x13) | 2)
				face += 0x20
		else:
			_routed.write_u8(ctl + 0x67a, _routed.read_u8(ctl + 0x67a) & 0xfe)
			var angle: int = C68kScript.divs_trunc(C68kScript.s32(-C68kScript.lsl32(0x2d - abs_int(pos), 12)), 0x2d) & 0x3fff
			a7 = entry_a7 - 0x8c
			build_attitude_matrix_3ang_alt(angle, angle, 0, matrix_pos)
			a7 = entry_a7 - 0x9c
			build_attitude_matrix_3ang_alt(angle, (-angle) & 0x3fff, 0, matrix_neg)
			a7 = entry_a7
			var world: int = _routed.read_u32(DAT_0001b5a0)
			var tmpl: int = C68kScript.u32(_routed.read_u32(_routed.read_u32(_routed.read_u32(obj + 0x24) + 0x28) + 0x2e + _routed.read_u8(obj + 1) * 0x18) + _routed.read_u32(world + 0x8c) + 0x22)
			var origin := [_routed.read_u32(tmpl), _routed.read_u32(tmpl + 4), _routed.read_u32(tmpl + 8)]
			var n_off: int = _routed.read_s16(obj + 0x36) * 0xc
			var verts: int = _routed.read_u32(obj + 0x44)
			var shift: int = _routed.read_s16(obj + 0x34)
			var x_pos: int = C68kScript.s16(C68kScript.lsl32(0x46, shift))
			var x_neg: int = C68kScript.s16(C68kScript.lsl32(-0x46, shift))
			var pivot_dy: int = C68kScript.s32(C68kScript.lsl32(0x1a, shift))
			var i: int = 0
			while i < _routed.read_s16(obj + 0x3a):
				if _routed.read_u8(face + 0x17) == 1:
					_routed.write_u8(face + 0x13, _routed.read_u8(face + 0x13) & 0xfd)
					var idx: int = _routed.read_u32(face + 0x18)
					var mat: int = matrix_neg
					var x_off: int = x_neg
					if _routed.read_s32(tmpl + _routed.read_s16(idx) * 0xc) > 0:
						mat = matrix_pos
						x_off = x_pos
					var src: int = tmpl + n_off + i * 0xc
					var dst: int = verts + n_off + i * 0xc
					for k in range(3):
						_routed.write_u32(dst + 4 * k, C68kScript.u32(_routed.read_u32(src + 4 * k) - origin[k]))
					transform_vecs12_to_int3_by_matrix3(1, dst, dst, mat)
					for k in range(3):
						_routed.write_u32(dst + 4 * k, C68kScript.u32(_routed.read_u32(dst + 4 * k) + origin[k]))
					var left2: int = _routed.read_u16(face + 0x14)
					while true:
						left2 = C68kScript.u16(left2 - 1)
						if left2 == 0xffff:
							break
						var v: int = _routed.read_s16(idx) * 0xc
						idx += 2
						var sv: int = tmpl + v
						var dv: int = verts + v
						_routed.write_u32(dv, C68kScript.u32(_routed.read_u32(sv) - x_off))
						_routed.write_u32(dv + 4, C68kScript.u32(pivot_dy + _routed.read_u32(sv + 4)))
						_routed.write_u32(dv + 8, _routed.read_u32(sv + 8))
						transform_vecs12_to_int3_by_matrix3(1, dv, dv, mat)
						_routed.write_u32(dv, C68kScript.u32(_routed.read_u32(dv) + x_off))
						_routed.write_u32(dv + 4, C68kScript.u32(_routed.read_u32(dv + 4) - pivot_dy))
				i += 1
				face += 0x20
	a7 = entry_a7 - 0x8c
	build_attitude_matrix_x((_routed.read_s16(ctl + 0x626) - _routed.read_s16(_routed.read_u32(ctl + 4) + 0x44)) & 0x3fff, _routed.read_s16(ctl + 0x20), _routed.read_s16(ctl + 0x22), _routed.read_s16(ctl + 0x24), 0x1d72c)
	a7 = entry_a7
	return 1


