		if chance <= (overlay_rng_next() & 0x7f):
			return
		_routed.write_u32(self_ctl + 0x692, other_obj)
		_routed.write_u32(self_ctl + 0x696, C68kScript.u32(dist))
		_routed.write_u8(other_obj + 3, C68kScript.u8(_routed.read_u8(other_obj + 3) + 1))
		return
	if _routed.read_u32(self_ctl + 0x692) != 0:
		chance = chance >> 1
	if chance <= (overlay_rng_next() & 0x7f):
		return
	var held: int = _routed.read_u32(self_ctl + 0x692)
	if held != 0 and C68kScript.s32(C68kScript.lsl32(dist, 1)) >= _routed.read_s32(self_ctl + 0x696):
