# pacific_conflict.gd:6315 update_aircraft_damage_state
func update_aircraft_damage_state(ctl: int) -> void:
	assert(memory != null, "update_aircraft_damage_state requires original global memory")
	var entry_a7: int = a7
	var obj: int = _routed.read_u32(ctl)
	var timer_range: int = 0
	var damage: int = _routed.read_u16(ctl + 0x684)
	var prev: int = _routed.read_u16(ctl + 0x686)
	if _routed.read_u16(ctl + 0x688) != 0:
		_routed.write_u16(ctl + 0x688, C68kScript.u16(_routed.read_u16(ctl + 0x688) - 1))
		damage = damage & 0xfc3f
	while true:
		var before: int = damage
		var stage: int = damage & 0x3c0
		if stage == 0x40:
			timer_range = 0xff
			if (prev & 0x40) == 0:
				a7 = entry_a7 - 0x2c
				attach_smoke_trail(_routed.read_u32(obj + 0x18), _routed.read_u32(obj + 0x1c), _routed.read_u32(obj + 0x20), ctl)
				a7 = entry_a7
			elif (overlay_rng_next() & 1) != 0:
				damage = damage & 0xffbf
				if (overlay_rng_next() & 1) != 0:
					damage = damage | 0x80
				else:
					damage = damage | 0x200
		elif stage == 0x80:
			timer_range = 0xff
			if (prev & 0x80) != 0 and (overlay_rng_next() & 3) == 0:
				damage = (damage & 0xff7f) | 0x200
		elif stage == 0x100:
			if (_routed.read_u8(ctl + 0x684) & 8) != 0:
				_routed.write_u16(ctl + 0x688, 0x16)
			else:
				timer_range = 0xff
			if (prev & 0x100) == 0:
				a7 = entry_a7 - 0x2c
				attach_trailing_plume(_routed.read_u32(obj + 0x18), _routed.read_u32(obj + 0x1c), _routed.read_u32(obj + 0x20), ctl)
				a7 = entry_a7
			elif (_routed.read_u8(ctl + 0x684) & 8) != 0 or (overlay_rng_next() & 1) != 0:
				damage = (damage & 0xfeff) | 0x400
		elif stage == 0x200:
			timer_range = 0xff
		var changed: int = (before ^ damage) & 0xffff
		_routed.write_u16(ctl + 0x684, _routed.read_u16(ctl + 0x684) & (~changed & 0xffff))
		_routed.write_u16(ctl + 0x684, _routed.read_u16(ctl + 0x684) | (changed & damage))
		prev = before & changed
		damage = changed & damage
		if damage == 0:
			break
	var host: int = _routed.read_u32(DAT_0001b5a0)
	var player: int = _routed.read_u32(DAT_0001b738)
	if (_routed.read_u8(ctl + 0x684) & 4) != 0 and (_routed.read_u8(ctl + 0x686) & 4) == 0:
		if ctl == player:
			a7 = entry_a7 - 0x20
			request_instant_replay(0 if (_routed.read_u8(ctl + 0x684) & 8) != 0 else 1)
			a7 = entry_a7
			if _routed.read_u16(DAT_0001b870) == 0:
				_routed.write_u16(host + 0x98, 2)
			_routed.write_u32(DAT_0001b884, _routed.read_u32(DAT_0001b888))
			if _routed.read_u16(DAT_0001b870) != 0:
				if _routed.read_u32(DAT_0001b87c) == 0:
					_routed.write_u16(host + 0xd4, 1)
				elif _routed.read_u16(DAT_0001b87a) != 0:
					_routed.write_u16(host + 0xd4, 4)
		_routed.write_u16(ctl + 0x684, _routed.read_u16(ctl + 0x684) & 0xfc3f)
		var saved: int = _routed.read_u16(DAT_0001b870)
		_routed.write_u16(DAT_0001b870, 0xffff)
		a7 = entry_a7 - 0x24
		spawn_destruction_effect(obj, 300 if _routed.read_u32(ctl + 0x32) == 0x111ba else 100)
		a7 = entry_a7
		_routed.write_u16(DAT_0001b870, saved)
		if saved == 0:
			var type: int = _routed.read_s16(_routed.read_u32(ctl + 4))
			if _routed.read_s16(host + 0x90) == 5 and type == 2 and _routed.read_u16(host + 0xce) == 0:
				_routed.write_u16(host + 0xce, 0xffff)
			if _routed.read_s16(host + 0x90) == 6 and type == 3 and _routed.read_u16(host + 0xce) == 0:
				_routed.write_u16(host + 0xce, 1)
			if _routed.read_s16(host + 0x90) == 7:
				a7 = entry_a7 - 0x20
				remove_mission_target(ctl)
				a7 = entry_a7
			var tally: int = _routed.read_s16(obj + 0x50)
			if tally != 0 and _routed.read_s8(ctl + 0x684) < 0:
				var counter: int = host + 0xb8 + tally * 2 if tally > 0 else host + 0xd2
				_routed.write_u16(counter, C68kScript.u16(_routed.read_u16(counter) + 1))
		a7 = entry_a7 - 0x20
		dispatch_entity_cleanup(obj)
		a7 = entry_a7
	if (_routed.read_u8(ctl + 0x684) & 0x10) != 0 and (_routed.read_u8(ctl + 0x686) & 0x10) == 0:
		a7 = entry_a7 - 0x2c
		attach_ground_fire(_routed.read_u32(obj + 0x18), _routed.read_u32(ctl + 0x2e), _routed.read_u32(obj + 0x20), ctl)
		a7 = entry_a7
	if (_routed.read_u8(ctl + 0x684) & 1) != 0 and _routed.read_u8(ctl + 0x677) == 0 and ctl != player:
		if (overlay_rng_next() & 0x1f) == 0 and _routed.read_u32(ctl + 0x32) != 0x111ba and _routed.read_s16(host + 0x90) != 2:
			_routed.write_u8(ctl + 0x677, 1)
	if ctl == player and (_routed.read_u8(ctl + 0x685) & 1) != 0 and (_routed.read_u8(ctl + 0x687) & 1) == 0:
		_routed.write_u16(DAT_0001b874, 1)
		_routed.write_u16(DAT_0001b872, 0)
		if _routed.read_u32(DAT_0001b87c) == 0:
			_routed.write_u16(host + 0xd4, 1)
			_routed.write_u16(DAT_0001b844, 1)
	if timer_range != 0:
		var r: int = overlay_rng_next() & 0xffff
		_routed.write_u16(ctl + 0x688, C68kScript.u16(((timer_range & r) >> 1) + (timer_range >> 1)))
	_routed.write_u16(ctl + 0x686, _routed.read_u16(ctl + 0x684))


# pacific_conflict.gd:6436 aircraft_tick
func aircraft_tick(ctl: int) -> void:
	assert(memory != null, "aircraft_tick requires original global memory")
	var entry_a7: int = a7
	var pose: int = ctl + 0x36 + _routed.read_s16(ctl + 0x612) * 0x14
	_routed.write_u16(ctl + 0x612, C68kScript.u16(_routed.read_u16(ctl + 0x612) + 1))
	if _routed.read_u16(ctl + 0x612) == 0x4b:
		_routed.write_u16(ctl + 0x612, 0)
	var obj: int = _routed.read_u32(ctl)
	if _routed.read_u16(DAT_0001b870) == 0:
		if (_routed.read_u8(ctl + 0x684) & 4) != 0 and (_routed.read_u8(ctl + 0x686) & 4) != 0:
			for k in range(3):
				_routed.write_u32(ctl + 8 + 4 * k, 0)
		else:
			a7 = entry_a7 - 0x18
			_jsr(_routed.read_u32(ctl + 0x32), [ctl])
			a7 = entry_a7
		a7 = entry_a7 - 0x18
		update_aircraft_damage_state(ctl)
		a7 = entry_a7
		for k in range(3):
			_routed.write_u32(pose + 4 * k, C68kScript.u32(_routed.read_u32(obj + 0x18 + 4 * k) + _routed.read_u32(ctl + 8 + 4 * k)))
		_routed.write_u16(pose + 0xc, _routed.read_u16(ctl + 0x20))
		_routed.write_u16(pose + 0xe, _routed.read_u16(ctl + 0x22))
		_routed.write_u16(pose + 0x10, _routed.read_u16(ctl + 0x24))
		_routed.write_u16(pose + 0x12, _routed.read_u16(ctl + 0x684))
		return
	var frame: int = _routed.read_s32(DAT_0001b838)
	if frame < _routed.read_s32(obj + 0x40):
		return
	var recorded: int = _routed.read_u16(pose + 0x12)
	if _routed.read_s16(DAT_0001b870) == 1 or frame == _routed.read_s32(obj + 0x40):
		for k in range(3):
			_routed.write_u32(ctl + 8 + 4 * k, 0)
			_routed.write_u32(obj + 0x18 + 4 * k, _routed.read_u32(pose + 4 * k))
		_routed.write_u16(ctl + 0x688, 0)
		_routed.write_u16(ctl + 0x686, recorded & 0xeeff)
		_routed.write_u16(ctl + 0x684, recorded)
		_routed.write_u8(ctl + 0x679, 0 if (_routed.read_u8(ctl + 0x684) & 0x20) != 0 else 0x2d)
		if (recorded & 0x3c0) != 0 and (_routed.read_u8(pose + 0x12) & 0x10) == 0:
			_routed.write_u16(ctl + 0x684, _routed.read_u16(ctl + 0x684) & 0xfc3f)
			_routed.write_u16(ctl + 0x686, _routed.read_u16(ctl + 0x686) & 0xfc3f)
			_routed.write_u16(ctl + 0x684, _routed.read_u16(ctl + 0x684) | 0x40)
	else:
		for k in range(3):
			_routed.write_u32(ctl + 8 + 4 * k, C68kScript.u32(_routed.read_u32(pose + 4 * k) - _routed.read_u32(obj + 0x18 + 4 * k)))
		_routed.write_u16(ctl + 0x684, recorded)
		_routed.write_u16(ctl + 0x688, 0 if ((_routed.read_u16(ctl + 0x684) ^ _routed.read_u16(ctl + 0x686)) & 0x3c0) != 0 else 1)
	_routed.write_u16(ctl + 0x20, _routed.read_u16(pose + 0xc))
	_routed.write_u16(ctl + 0x22, _routed.read_u16(pose + 0xe))
	_routed.write_u16(ctl + 0x24, _routed.read_u16(pose + 0x10))
	var flags_now: int = _routed.read_u16(ctl + 0x684)
	a7 = entry_a7 - 0x18
	update_aircraft_damage_state(ctl)
	a7 = entry_a7
