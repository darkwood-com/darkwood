		for k in n:
			memory.write_u8(C68kScript.u32(dst + k), memory.read_u8(C68kScript.u32(src + k)))
	else:
		for k in range(n - 1, -1, -1):
			memory.write_u8(C68kScript.u32(dst + k), memory.read_u8(C68kScript.u32(src + k)))
