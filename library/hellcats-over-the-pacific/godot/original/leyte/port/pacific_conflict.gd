## 0xe40c: the word angle folded into -0x2000..0x2000 (+-0x4000 once), sign-extended.
func fold_angle_pm_0x2000(angle: int) -> int:
	var a: int = C68kScript.s16(angle)
	if a > 0x2000:
		a = C68kScript.s16(a - 0x4000)
	elif a < -0x2000:
		a = C68kScript.s16(a + 0x4000)
	return a

