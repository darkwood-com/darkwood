	code_table[0x1b560] = func(o: int, k: int, _c: int = 0) -> int: return register_debris_template(o, k)
	code_table[0x1b722] = func(o: int, k: int, _c: int = 0) -> int: return register_ground_mark_template(o, k)
	code_table[0x1d276] = func(o: int, k: int, _c: int = 0) -> int: return register_turret_template(o, k)
	code_table[0x1d56e] = func(o: int, k: int, _c: int = 0) -> int: return register_parachute_template(o, k)
	code_table[0x1dbb4] = func(o: int, k: int, _c: int = 0) -> int: return register_cloud_templates(o, k)
	code_table[0x19e30] = Callable(self, "bullet_pre_render")
	code_table[0x148dc] = Callable(self, "effect_pre_render_hook")
