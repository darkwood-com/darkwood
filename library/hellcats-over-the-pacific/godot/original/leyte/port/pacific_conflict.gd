	var record: int
	var face_index: int
	var child_index: int
	var child: int
	var face: int
	var entry_a7: int = a7

	child_index = 0
	if 0 < memory.read_s16(group + 0x18):
		while true:
			record = group + 0x1a + child_index * 0x18
			memory.write_u32(path, record)
			child = C68kScript.u32(memory.read_u32(memory.read_u32(DAT_0001b5a0) + 0x8c) + memory.read_u32(record + 0x14))
