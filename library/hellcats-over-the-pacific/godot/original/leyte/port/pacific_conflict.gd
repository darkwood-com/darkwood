## A long shifted by a signed count: asr by -n when n < 0, else asl by n.
func _shift_signed(v: int, n: int) -> int:
	if n < 0:
		return C68kScript.asr32(v, -n)
	return C68kScript.s32(C68kScript.lsl32(v, n))

