					memory.write_u32(pair[1] + 4 * k, _locked_pointer(memory.read_u32(pair[0] + 4 * k)))
		memory.write_u32(0x20f7c, memory.read_u32(0x20f70))
		memory.write_u32(0x20f80, memory.read_u32(DAT_0001b778))
	a7 = entry_a7 - 0x1c
	update_view_clip_bounds()
	a7 = entry_a7

