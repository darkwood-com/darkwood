{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkwood.com/schemas/public-projects-v1.json",
  "title": "Public project catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "projects"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "repository": { "type": "string", "format": "uri" },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "description", "topics"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "path": { "type": "string", "pattern": "^library/[^/]+$" },
          "description": { "type": "string", "minLength": 1 },
          "topics": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
          }
        }
      }
    }
  }
}
