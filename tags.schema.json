{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkwood.com/schemas/public-projects-v2.json",
  "title": "Public project catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "projects"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "repository": { "type": "string", "format": "uri" },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "domain", "description", "kind", "lifecycle", "topics"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "path": { "type": "string", "pattern": "^library/[^/]+$" },
          "domain": { "enum": ["darkwood", "matyo91"] },
          "description": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["product", "component", "content", "tool", "infrastructure", "operations", "experiment", "other"] },
          "lifecycle": { "$ref": "#/$defs/lifecycle" },
          "topics": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
          }
        }
      }
    }
  },
  "$defs": {
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "support", "archivedAt", "replacement"],
      "properties": {
        "status": { "enum": ["active", "maintenance", "archived", "deprecated"] },
        "support": { "enum": ["standard", "security", "best-effort", "none"] },
        "archivedAt": { "type": ["string", "null"], "format": "date" },
        "replacement": { "type": ["string", "null"] }
      }
    }
  }
}
