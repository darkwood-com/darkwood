{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkwood.com/schemas/public-projects-v3.json",
  "title": "Public project catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "projects"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 3 },
    "repository": { "type": "string", "format": "uri" },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "domain", "description", "kind", "status", "dependencies", "topics"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "path": { "type": "string", "pattern": "^library/[^/]+$" },
          "domain": { "enum": ["darkwood", "matyo91"] },
          "description": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["product", "component", "content", "tool", "infrastructure", "operations", "experiment", "other"] },
          "status": { "enum": ["backlog", "working", "done"] },
          "dependencies": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
            "uniqueItems": true
          },
          "topics": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
          }
        }
      }
    }
  }
}
