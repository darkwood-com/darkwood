        "source": "library/content-darkwood-memory",
        "artifact": "library/content-darkwood-memory/dist",
        "repository": "darkwood-com/content-darkwood-memory",
        "credential": "PAGES_MEMORY_SSH_KEY",
        "domain": "memory.content.darkwood.com",
        "builder": "nix",
        "nodeTest": "content-darkwood-memory"
      }
    },
    {
      "id": "content-darkwood-intent",
      "source": "library/content-darkwood-intent",
      "repository": "darkwood-com/content-darkwood-intent",
      "credential": "PAGES_INTENT_SSH_KEY",
