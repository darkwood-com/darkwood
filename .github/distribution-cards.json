{
  "schemaVersion": 1,
  "authentication": "deploy-keys-pending-github-app",
  "cards": [
    {
      "id": "organization-profile",
      "source": "library/.github",
      "repository": "darkwood-com/.github",
      "credential": "MIRROR_ORGANIZATION_PROFILE_SSH_KEY",
      "git": {
        "branch": "main"
      },
      "structuralException": "GitHub organization community repository"
    },
    {
      "id": "personal-profile",
      "source": "library/matyo91",
      "repository": "matyo91/matyo91",
      "credential": "MIRROR_PERSONAL_PROFILE_SSH_KEY",
      "git": {
        "branch": "main"
      },
      "structuralException": "GitHub personal profile repository"
    },
    {
      "id": "darkwood-php-component-flow",
      "source": "library/darkwood-php/src/Darkwood/Component/Flow",
      "repository": "darkwood-com/flow",
      "credential": "MIRROR_FLOW_SSH_KEY",
      "targetRepository": "darkwood-com/darkwood-php-component-flow",
      "git": {
        "branch": "8.1",
        "composer": "darkwood/flow",
        "packageId": "flow",
        "phpExtensions": "xsl, openswoole",
        "mysql": false
      },
      "pages": {
        "source": "library/darkwood-php/src/Darkwood/Component/Flow/docs",
        "artifact": "library/darkwood-php/src/Darkwood/Component/Flow/docs/src/public",
        "repository": "darkwood-com/flow-pages",
        "credential": "PAGES_FLOW_SSH_KEY",
        "domain": "flow.darkwood.com",
        "builder": "node"
      }
    },
    {
      "id": "darkwood-php-component-navi",
      "source": "library/darkwood-php/src/Darkwood/Component/Navi",
      "repository": "darkwood-com/navi",
      "credential": "MIRROR_NAVI_SSH_KEY",
      "targetRepository": "darkwood-com/darkwood-php-component-navi",
      "git": {
        "branch": "8.1",
        "composer": "darkwood/navi",
        "packageId": "navi",
        "phpExtensions": "xsl, openswoole",
        "mysql": true
      }
    },
    {
      "id": "darkwood-php-bundle-media",
      "source": "library/darkwood-php/src/Darkwood/Bundle/MediaBundle",
      "repository": "darkwood-com/media-bundle",
      "credential": "MIRROR_MEDIA_BUNDLE_SSH_KEY",
      "targetRepository": "darkwood-com/darkwood-php-bundle-media",
      "git": {
        "branch": "8.1",
        "composer": "darkwood/media-bundle",
        "packageId": "media-bundle",
        "phpExtensions": "ctype, iconv",
        "mysql": false
      }
    },
    {
      "id": "darkwood-php-bundle-ia-exception",
      "source": "library/darkwood-php/src/Darkwood/Bundle/IaExceptionBundle",
      "repository": "darkwood-com/ia-exception-bundle",
      "credential": "MIRROR_IA_EXCEPTION_BUNDLE_SSH_KEY",
      "targetRepository": "darkwood-com/darkwood-php-bundle-ia-exception",
      "git": {
        "branch": "8.1",
        "composer": "darkwood/ia-exception-bundle",
        "packageId": "ia-exception-bundle",
        "phpExtensions": "ctype, iconv",
        "mysql": false
      }
    },
    {
      "id": "content-darkwood-memory",
      "source": "library/content-darkwood-memory",
      "repository": "darkwood-com/content-darkwood-memory",
      "credential": "PAGES_MEMORY_SSH_KEY",
