{
    "name": "darkwood/navi",
    "description": "Public architectural layer for structured workflow execution.",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "symfony/console": "8.0.*",
        "symfony/dotenv": "8.0.*",
        "symfony/flex": "^2.10",
        "symfony/framework-bundle": "8.0.*",
        "symfony/runtime": "8.0.*",
        "symfony/yaml": "8.0.*"
    },
    "require-dev": {
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Navi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Navi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "demo": "php bin/console navi:workflow:run",
        "test": "tools/phpunit/vendor/bin/phpunit --configuration=tools/phpunit/phpunit.xml",
        "php-cs-fixer": "cd tools && castor app:tools:php-cs-fixer --dry-run",
        "phpstan": "cd tools && castor app:tools:phpstan",
        "phpunit": "cd tools && castor app:tools:phpunit",
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "env": "cd tools && castor app:tools:env"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.0.*"
        }
    }
}
