{
    "name": "darkwood/navi",
    "type": "library",
    "description": "Public architectural layer for structured workflow execution.",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "symfony/console": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/flex": "^2.11",
        "symfony/framework-bundle": "^8.1",
        "symfony/runtime": "^8.1",
        "symfony/yaml": "^8.1"
    },
    "require-dev": {
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Navi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Navi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "demo": "php bin/console navi:workflow:run",
        "php-cs-fixer": "cd tools && castor app:tools:php-cs-fixer",
        "phpstan": "cd tools && castor app:tools:phpstan",
        "phpunit": "cd tools && castor app:tools:phpunit",
        "env": "cd tools && castor app:tools:env",
        "symfony-lsp": "cd tools && castor app:tools:symfony-lsp",
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "^8.1"
        }
    }
}
